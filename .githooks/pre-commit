#!/usr/bin/env bash
# Pre-commit hook — runs automatically before every commit.
# Install once per clone: git config core.hooksPath .githooks
set -euo pipefail

# 1. Roadmap comment guard — restore the header comment block that the upstream
#    harness roadmap tooling silently strips, before linting. Affects both
#    `roadmap promote` (#273) and `roadmap shard` + `regen` (#629). Reported
#    upstream as Intense-Visions/harness-engineering#1328.
STAGED_ROADMAP=$(git diff --cached --name-only --diff-filter=ACM | grep '^docs/roadmap\.md$' || true)
if [ -n "$STAGED_ROADMAP" ] && [ -f "scripts/roadmap_comment_guard.mjs" ]; then
  node scripts/roadmap_comment_guard.mjs
  git add docs/roadmap.md
fi

# 2. Markdownlint — check staged .md files only
#
#    Resolution order matters here (#725). All work on this repo happens in a
#    `git worktree`, and `core.hooksPath` is an absolute path into the MAIN
#    checkout — so the hook always runs, but a worktree has no root
#    `node_modules` of its own and both original probes were CWD-relative. A
#    worktree created as a sibling (`../canary-<slug>`, the AGENTS.md
#    convention) is also outside the directory chain `npx` walks upward, so it
#    resolved nothing either and markdownlint went dark for essentially all
#    work. A worktree nested *under* the main checkout resolved by accident —
#    which is worse, because the gate's coverage then depended on where the
#    worktree happened to be created.
#
#    The common git dir points at the main checkout unconditionally, worktree or
#    not, so its sibling `node_modules` is the one install this hook can always
#    name. Probed last: a tree with its own deps should use its own.
MAIN_CHECKOUT_MARKDOWNLINT=""
COMMON_GIT_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
if [ -n "$COMMON_GIT_DIR" ]; then
  CANDIDATE="$(dirname "$COMMON_GIT_DIR")/node_modules/.bin/markdownlint"
  if [ -x "$CANDIDATE" ]; then
    MAIN_CHECKOUT_MARKDOWNLINT="$CANDIDATE"
  fi
fi

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
STAGED_MD_FILTERED=$(echo "$STAGED_MD" | grep -v '^agents/agents/' | grep -v '^agents/commands/' || true)
if [ -n "$STAGED_MD_FILTERED" ]; then
  if [ -x "node_modules/.bin/markdownlint" ]; then
    echo "[pre-commit] markdownlint: checking staged markdown files..."
    echo "$STAGED_MD_FILTERED" | xargs node_modules/.bin/markdownlint
  elif npx --no-install markdownlint --version >/dev/null 2>&1; then
    # A worktree may symlink only `ts/node_modules` and have no root install.
    # `--no-install` keeps this offline and silent-fast when nothing resolves.
    echo "[pre-commit] markdownlint: checking staged markdown files (resolved via npx)..."
    echo "$STAGED_MD_FILTERED" | xargs npx --no-install markdownlint
  elif [ -n "$MAIN_CHECKOUT_MARKDOWNLINT" ]; then
    echo "[pre-commit] markdownlint: checking staged markdown files (resolved from the main checkout)..."
    echo "$STAGED_MD_FILTERED" | xargs "$MAIN_CHECKOUT_MARKDOWNLINT"
  else
    # The skip is intentional; the silence was the defect (#650). A dep-less
    # clone must still be able to commit, but it must not look like a clean run.
    # The remedy names this tree and the main checkout, because #725 was
    # triggered by an install missing from a *worktree* while the message sent
    # the reader to a repo root that already had one.
    echo "[pre-commit] markdownlint: SKIPPED — no markdownlint binary resolved (run 'npm ci' at the root of this tree, or of the main checkout)."
    echo "             Staged markdown was NOT linted here. CI's docs-lint still gates it."
  fi
fi

# 3. Prettier — mirror the CI format gates for the packages this commit touches.
#
#    Deliberately runs the SAME `format:check` script CI runs rather than a
#    hand-rolled file list, so the hook can never disagree with CI about what
#    "formatted" means — the failure mode that motivated adding this at all.
#
#    Scope matters: only `ts/` and `agents/skills/` are format-gated in CI
#    (.github/workflows/harness-quality.yml). ~184 other tracked files are not
#    prettier-clean and are not meant to be — notably the golden JSON fixtures
#    under `ts/test/fixtures/`, which are byte-compared test DATA and would be
#    corrupted by reformatting. A repo-wide gate would block unrelated commits
#    and invite exactly that damage.
#
#    Check-only, never `--write`: auto-formatting and re-staging would also
#    stage unstaged hunks of a partially staged file.
fmt_gate() { # <package-dir> <label>
  if [ ! -x "$1/node_modules/.bin/prettier" ]; then
    # No npx fallback here on purpose: this gate deliberately runs the package's
    # own `format:check` script (see above), which needs that package's local
    # install anyway — an npx-resolved prettier would use a different config.
    echo "[pre-commit] prettier: SKIPPED for $2 — $1/node_modules/.bin/prettier not found (run 'npm ci' in $1)."
    echo "             Formatting was NOT checked here. CI's harness-quality gate still checks it."
    return 0
  fi
  echo "[pre-commit] prettier: checking $2..."
  if ! (cd "$1" && npm run --silent format:check); then
    echo ""
    echo "[pre-commit] Formatting issues in $2 — CI would fail on these."
    echo "             Fix with: (cd $1 && npx prettier --write <file>)"
    return 1
  fi
}

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
if echo "$STAGED_ALL" | grep -q '^ts/'; then
  fmt_gate ts "ts/ (engine)"
fi
if echo "$STAGED_ALL" | grep -q '^agents/skills/'; then
  fmt_gate agents/skills "agents/skills/"
fi

# 4. Security ledger — regenerate if source files changed, then stage
LEDGER_SOURCES=$(git diff --cached --name-only | grep -Ev '^(\.harness/security/timeline\.json|docs/SECURITY_LEDGER\.md)$' || true)
if [ -n "$LEDGER_SOURCES" ] && [ -f "scripts/security_ledger.mjs" ]; then
  echo "[pre-commit] refreshing security ledger..."
  node scripts/security_ledger.mjs 2>/dev/null || true
  git add .harness/security/timeline.json docs/SECURITY_LEDGER.md 2>/dev/null || true
fi
