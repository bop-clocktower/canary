# after running the guard sweeps it into the commit.
.harness/cache/

# Harness runtime state (machine-local; regenerated each session — never commit)
.harness/state.json
.harness/state.events.jsonl
.harness/state.json.imported

# Superpowers brainstorm sessions
.superpowers/
