# ── Node / JavaScript ─────────────────────────────────────────
# No trailing slash: agent worktrees symlink node_modules rather than install
# it, and `node_modules/` matches a directory but not a symlink of that name,
# leaving it untracked and one `git add -A` away from being committed (#650).
node_modules
playwright-report/
blob-report/

# Root markdownlint scratch — CI runs `npx --yes markdownlint-cli`, no root node project
/package.json
/package-lock.json

# ── Environment & secrets ─────────────────────────────────────
.env
.env.*
.envrc

# ── Editor & OS ───────────────────────────────────────────────
.idea/
.vscode/
.DS_Store

# Claude Code — settings.json is tracked (shared hooks + MCP config)
# settings.local.json is personal (extra allows, tokens) — never commit
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Agent-tooling artifacts (machine-local; never commit) ─────
# The skills-manager extension writes telemetry and per-vendor config mirrors
# into the repo. Two reasons none of it belongs here:
#   1. mcp-usage.jsonl records absolute local paths, session IDs, and full
#      bash command strings — this repo is public.
#   2. The learning/ stores are per-machine state; committing them would make
#      every clone inherit one developer's cost and adoption history.
# Globbed rather than path-listed because the hooks resolve from cwd, not the
# repo root — running a command in ts/ or npm/ grows another copy.
**/.claude/learning/
**/.claude/mcp-usage.jsonl

# Same extension, re-emitting the local .claude/skills/ set per agent vendor.
# .claude/skills/ is itself untracked, so these mirrors document tooling no
# contributor has — committing them would be pure drift.
# Subpaths, not the whole dir: `.cursor/mcp.json` is tracked, shared config.
.cursor/hooks.json
.cursor/learning/
.cursor/skills/
.kiro/
.github/copilot-instructions.md
.github/instructions/
.github/hooks/

# harness CLI machine identity — regenerated per install
**/.harness/.install-id
**/.harness/.telemetry-notice-shown

# Personal skill INSTALLS — listed by name, deliberately not `.claude/skills/`
# wholesale. Each carries a `.skill-version.json` receipt
# ({"version", "installedAt"}) rather than authorship, and skill-creator ships
# an Apache-2.0 LICENSE: third-party artifacts, not source. Committing them
# would vendor someone else's code at whatever version one developer happened to
# install, and hand every contributor a set of Terraform and Azure skills to
# work on a testing CLI.
#
# A blanket rule would also foreclose committing a genuine PROJECT skill here,
# and do it silently — the file would simply never appear in `git status`.
# Listing the installs instead leaves `.claude/skills/` open by default, so an
# authored skill commits with no ceremony. `agents/skills/` remains where the
# product's shipped skills live; this is for skills that serve the repo itself.
#
# `ts/test/agent-artifact-ignores.test.ts` enforces both halves: a
# receipt-bearing directory must be ignored, and one without a receipt must not
# be. Install a 16th skill and that test names it and points here.
.claude/skills/azure-rbac-diagnostics/
.claude/skills/cross-platform-scripting/
.claude/skills/deployment-practical/
.claude/skills/doc-coauthoring/
.claude/skills/file-style-conventions/
.claude/skills/github-actions-ci/
.claude/skills/gitlab-pipeline-ops/
.claude/skills/self-learning/
.claude/skills/skill-creator/
.claude/skills/skill-feedback-adaptation/
.claude/skills/skill-official-updater/
.claude/skills/skill-usage-insights/
.claude/skills/terraform-module-ops/
.claude/skills/terraform-plan-review/
.claude/skills/vitest-extension-testing/

# Claude Code runtime state — per-machine, regenerated, and in the case of
# worktrees/ a live checkout of in-flight branches. These lived in
# .git/info/exclude, which is machine-local and never shared, so the second
# laptop and every fresh clone saw them as untracked (#567 flagged this).
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/routines/.state/
**/.claude/scheduled_tasks.json
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/assistant-daemon-state.json
**/.claude/first-run
.claude/position.local.json
.claude/profile.local.json

# Proprietary denylist for the company-leak guard (kept local; CI uses a secret)
.proprietary-denylist

# Downloaded native binaries (placed by npm postinstall)
npm/bin/canary
npm/bin/canary.exe

# Local turbo→ruff lint bridge (pairs with gitignored root package.json; see issue #253)
/turbo.json

