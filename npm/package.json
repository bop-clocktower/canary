{
  "name": "canary-test-cli",
  "version": "5.15.0",
  "description": "Canary — AI-powered test automation agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bop-clocktower/canary.git"
  },
  "bin": {
    "canary": "./bin/canary.js"
  },
  "exports": {
    "./reporter": {
      "types": "./dist/reporters/testtracker.d.ts",
      "require": "./dist/reporters/testtracker.js",
      "default": "./dist/reporters/testtracker.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "postinstall": "node scripts/install.js",
    "test": "npm run build && node --test \"scripts/__tests__/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/install.js"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
