{
  "name": "canary-test-cli",
  "version": "6.5.0",
  "description": "Canary — AI-powered test automation agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bop-clocktower/canary.git"
  },
  "bin": {
    "canary": "./bin/canary.js",
    "canary-mcp": "./bin/canary-mcp.js"
  },
  "exports": {
    "./reporter": {
      "types": "./dist/reporters/testtracker.d.ts",
      "require": "./dist/reporters/testtracker.js",
      "default": "./dist/reporters/testtracker.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.42.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-engine.mjs",
    "prepare": "npm run build",
    "pretest": "node scripts/sync-gate-result.mjs --check",
    "test": "tsc && node --test \"scripts/__tests__/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/canary.js",
    "bin/canary-mcp.js",
    "dist/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
