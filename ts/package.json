{
  "name": "@canary/engine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript pilot port of the Canary analysis engine (strangler migration).",
  "bin": {
    "canary": "bin/canary.js",
    "canary-mcp": "bin/canary-mcp.js"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.4",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
