{
  "name": "@canary/engine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript pilot port of the Canary analysis engine (strangler migration).",
  "bin": {
    "canary": "bin/canary.js",
    "canary-mcp": "bin/canary-mcp.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
