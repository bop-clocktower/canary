{
  "name": "@canary/engine-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript pilot port of the Canary analysis engine (strangler migration).",
  "bin": {
    "canary": "bin/canary.js",
    "canary-mcp": "bin/canary-mcp.js"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-data.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"../.github/workflows/*.yml\"",
    "test": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "commander": "^15.1.0",
    "js-yaml": "^5.5.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  }
}
