    "drift": {
      "checkApiSignatures": false,
      "docPaths": [
        "docs/**/*.md",
        "README.md",
        "**/README.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "CLAUDE.md",
        "CONTRIBUTING.md",
        "DEPLOY_CHECKLIST.md",
        "STRATEGY.md",
        "**/SKILL.md"
      ]
    }
  },
