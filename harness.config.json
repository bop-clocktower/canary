{
  "version": 1,
  "name": "canary",
  "template": {
    "language": "typescript",
    "version": 1,
    "level": "intermediate",
    "tooling": {
      "packageManager": "npm",
      "lockFile": "ts/package-lock.json",
      "linter": "prettier",
      "formatter": "prettier",
      "buildTool": "tsc",
      "testRunner": "vitest"
    }
  },
  "layers": [
    {
      "name": "cli",
      "pattern": "ts/src/**/*cli*.ts",
      "allowedDependencies": [
        "adoption",
        "briefing",
        "composition",
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "composition",
      "pattern": "ts/src/main-deps.ts",
      "allowedDependencies": [
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "entry",
      "pattern": "ts/src/*.ts",
      "allowedDependencies": [
        "briefing",
        "cli",
        "composition",
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "briefing",
      "pattern": "ts/src/briefing/**",
      "allowedDependencies": [
        "cli",
        "composition",
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "adoption",
      "pattern": "ts/src/adoption/**",
      "allowedDependencies": ["cli", "composition", "core", "ui", "util"]
    },
    {
      "name": "guardian",
      "pattern": "ts/src/guardian/**",
      "allowedDependencies": ["core", "util"]
    },
    {
      "name": "analysis",
      "pattern": "ts/src/analysis/**",
      "allowedDependencies": ["history", "core", "util"]
    },
    {
      "name": "history",
      "pattern": "ts/src/history/**",
      "allowedDependencies": ["core", "util"]
    },
    {
      "name": "core",
      "pattern": "ts/src/core/**",
      "allowedDependencies": ["util"]
    },
    {
      "name": "ui",
      "pattern": "ts/src/ui/**",
      "allowedDependencies": []
    },
    {
      "name": "util",
      "pattern": "ts/src/util/**",
      "allowedDependencies": []
    }
  ],
  "forbiddenImports": [
    {
      "from": "ts/src/util/**",
      "disallow": [
        "ts/src/core/**",
        "ts/src/guardian/**",
        "ts/src/analysis/**",
        "ts/src/history/**"
      ],
      "message": "util is a leaf: shared helpers must not reach back into engine, feature, or CLI code."
    },
    {
      "from": "ts/src/core/**",
      "disallow": [
        "ts/src/guardian/**",
        "ts/src/analysis/**",
        "ts/src/history/**"
      ],
      "message": "The engine core must not depend on the features built on top of it."
    }
  ],
  "architecture": {
    "thresholds": {
      "module-size": {
        "maxLoc": 1800,
        "maxFiles": 12
      },
      "dependency-depth": 4,
      "coupling": {
        "maxFanOut": 12
      }
    }
  },
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/bin/**",
      "**/target/**",
      "**/vendor/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.venv/**",
      "**/venv/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      "**/*.test.mjs",
      "**/*.test.cjs",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.spec.js",
      "**/*.spec.jsx",
      "**/*.spec.mjs",
      "**/*.spec.cjs",
      "tests/generated/**"
    ],
    "entryPoints": [
