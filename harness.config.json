{
  "version": 1,
  "name": "canary",
  "template": {
    "language": "typescript",
    "version": 1,
    "level": "intermediate",
    "tooling": {
      "packageManager": "npm",
      "lockFile": "ts/package-lock.json",
      "linter": "prettier",
      "formatter": "prettier",
      "buildTool": "tsc",
      "testRunner": "vitest"
    }
  },
  "layers": [
    {
      "name": "cli",
      "pattern": "ts/src/**/*cli*.ts",
      "allowedDependencies": [
        "composition",
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "composition",
      "pattern": "ts/src/main-deps.ts",
      "allowedDependencies": [
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "entry",
      "pattern": "ts/src/*.ts",
      "allowedDependencies": [
        "cli",
        "composition",
        "guardian",
        "analysis",
        "history",
        "core",
        "ui",
        "util"
      ]
    },
    {
      "name": "guardian",
      "pattern": "ts/src/guardian/**",
      "allowedDependencies": ["core", "util"]
    },
    {
      "name": "analysis",
      "pattern": "ts/src/analysis/**",
      "allowedDependencies": ["history", "core", "util"]
    },
    {
      "name": "history",
      "pattern": "ts/src/history/**",
      "allowedDependencies": ["core", "util"]
    },
    {
      "name": "core",
      "pattern": "ts/src/core/**",
      "allowedDependencies": ["util"]
    },
    {
      "name": "ui",
      "pattern": "ts/src/ui/**",
      "allowedDependencies": []
    },
    {
      "name": "util",
      "pattern": "ts/src/util/**",
      "allowedDependencies": []
    }
  ],
  "forbiddenImports": [
    {
      "from": "ts/src/util/**",
      "disallow": [
        "ts/src/core/**",
        "ts/src/guardian/**",
        "ts/src/analysis/**",
        "ts/src/history/**"
      ],
      "message": "util is a leaf: shared helpers must not reach back into engine, feature, or CLI code."
    },
    {
      "from": "ts/src/core/**",
      "disallow": [
        "ts/src/guardian/**",
        "ts/src/analysis/**",
        "ts/src/history/**"
      ],
      "message": "The engine core must not depend on the features built on top of it."
    }
  ],
  "architecture": {
    "thresholds": {
      "module-size": {
        "maxLoc": 1800,
        "maxFiles": 12
      },
      "dependency-depth": 4,
      "coupling": {
        "maxFanOut": 12
      }
    }
  },
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/bin/**",
      "**/target/**",
      "**/vendor/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.venv/**",
      "**/venv/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      "**/*.test.mjs",
      "**/*.test.cjs",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "**/*.spec.js",
      "**/*.spec.jsx",
      "**/*.spec.mjs",
      "**/*.spec.cjs",
      "tests/generated/**"
    ],
    "entryPoints": [
      "agents/skills/claude-code/canary-blackhawk/scripts/cli.mjs",
      "agents/skills/claude-code/canary-cassandra/scripts/cli.mjs",
      "agents/skills/claude-code/canary-cassandra/scripts/engine.mjs",
      "agents/skills/claude-code/canary-fail-fast/scripts/cli.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/cli.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/otel_bootstrap/instrument.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/otel_bootstrap/playwright-fixture.ts",
      "agents/skills/claude-code/canary-katana/scripts/cli.mjs",
      "agents/skills/claude-code/canary-savant/scripts/cli.mjs",
      "agents/skills/claude-code/canary-shadow/scripts/cli.mjs",
      "agents/skills/claude-code/canary-strix/scripts/cli.mjs",
      "agents/skills/claude-code/canary-test-reporter/scripts/cli.mjs",
      "agents/skills/vitest.config.ts",
      "hooks/_harness_dedup.mjs",
      "hooks/block-no-verify.mjs",
      "hooks/pre-compact-state.mjs",
      "hooks/protect-config.mjs",
      "hooks/quality-gate.mjs",
      "npm/scripts/build-engine.mjs",
      "npm/scripts/sync-gate-result.mjs",
      "npm/src/doctor.ts",
      "npm/src/reporters/testtracker.ts",
      "npm/src/router.ts",
      "npm/src/uninstall-render.ts",
      "npm/src/uninstall-scan.ts",
      "npm/src/uninstall-types.ts",
      "npm/src/uninstall.ts",
      "scripts/bump-version.mjs",
      "scripts/check_doc_fences.mjs",
      "scripts/check_doc_links.mjs",
      "scripts/check_hook_customizations.mjs",
      "scripts/check_removed_symbols.mjs",
      "scripts/entropy-ratchet.mjs",
      "scripts/harness-report-summary.mjs",
      "scripts/perf-ratchet.mjs",
      "scripts/refresh-arch-baseline.mjs",
      "scripts/roadmap-denominator-check.mjs",
      "scripts/roadmap-groom.mjs",
      "scripts/roadmap-sync.mjs",
      "scripts/roadmap_comment_guard.mjs",
      "scripts/security_ledger.mjs",
      "scripts/source-visibility.mjs",
      "ts/scripts/copy-data.mjs",
      "ts/src/cli.ts",
      "ts/src/mcp-server.ts",
      "ts/test/doc-links-testkit.ts",
      "ts/vitest.config.ts"
    ],
    "drift": {
      "checkApiSignatures": false,
      "docPaths": [
        "docs/**/*.md",
        "README.md",
        "**/README.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "CLAUDE.md",
        "DEPLOY_CHECKLIST.md",
        "STRATEGY.md",
        "**/SKILL.md"
      ]
    }
  },
  "performance": {
    "entryPoints": [
      "agents/skills/claude-code/canary-blackhawk/scripts/cli.mjs",
      "agents/skills/claude-code/canary-cassandra/scripts/cli.mjs",
      "agents/skills/claude-code/canary-cassandra/scripts/engine.mjs",
      "agents/skills/claude-code/canary-fail-fast/scripts/cli.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/cli.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/otel_bootstrap/instrument.mjs",
      "agents/skills/claude-code/canary-instrument/scripts/otel_bootstrap/playwright-fixture.ts",
      "agents/skills/claude-code/canary-katana/scripts/cli.mjs",
      "agents/skills/claude-code/canary-savant/scripts/cli.mjs",
      "agents/skills/claude-code/canary-shadow/scripts/cli.mjs",
      "agents/skills/claude-code/canary-test-reporter/scripts/cli.mjs",
      "agents/skills/vitest.config.ts",
      "hooks/_harness_dedup.mjs",
      "hooks/block-no-verify.mjs",
      "hooks/pre-compact-state.mjs",
      "hooks/protect-config.mjs",
      "hooks/quality-gate.mjs",
      "npm/scripts/build-engine.mjs",
      "npm/scripts/sync-gate-result.mjs",
      "npm/src/doctor.ts",
      "npm/src/reporters/testtracker.ts",
      "npm/src/router.ts",
      "npm/src/uninstall-render.ts",
      "npm/src/uninstall-scan.ts",
      "npm/src/uninstall-types.ts",
      "npm/src/uninstall.ts",
      "scripts/bump-version.mjs",
      "scripts/check_doc_fences.mjs",
      "scripts/check_doc_links.mjs",
      "scripts/check_hook_customizations.mjs",
      "scripts/check_removed_symbols.mjs",
      "scripts/entropy-ratchet.mjs",
      "scripts/harness-report-summary.mjs",
      "scripts/perf-ratchet.mjs",
      "scripts/refresh-arch-baseline.mjs",
      "scripts/roadmap-denominator-check.mjs",
      "scripts/roadmap-groom.mjs",
      "scripts/roadmap-sync.mjs",
      "scripts/roadmap_comment_guard.mjs",
      "scripts/security_ledger.mjs",
      "scripts/source-visibility.mjs",
      "ts/scripts/copy-data.mjs",
      "ts/src/cli.ts",
      "ts/src/mcp-server.ts",
      "ts/test/doc-links-testkit.ts",
      "ts/vitest.config.ts"
    ]
  },
  "knowledge": {
    "domainBlocklist": [".remember", ".kiro"]
  },
  "telemetry": {
    "enabled": true
  },
  "adoption": {
    "enabled": true
  },
  "agent": {
    "backends": {
      "craft": {
        "type": "claude"
      }
    }
  },
  "craft": {
    "llm": {
      "backend": "craft"
    }
  },
  "roadmap": {
    "tracker": {
      "kind": "github",
      "repo": "bop-clocktower/canary",
      "labels": ["harness-managed"],
      "statusMap": {
        "backlog": "open",
        "planned": "open",
        "in-progress": "open",
        "done": "closed",
        "blocked": "open"
      },
      "reverseStatusMap": {
        "closed": "done",
        "open:in-progress": "in-progress",
        "open:blocked": "blocked",
        "open:planned": "planned"
      }
    }
  }
}
