  "knowledge": {
    "domainBlocklist": [".remember", ".kiro"]
  },
  "telemetry": {
    "enabled": true
  },
  "adoption": {
    "enabled": true
  },
  "agent": {
    "backends": {
      "craft": {
        "type": "claude"
      }
    }
  },
  "craft": {
    "llm": {
      "backend": "craft"
    }
  },
  "roadmap": {
    "tracker": {
      "kind": "github",
      "repo": "bop-clocktower/canary",
      "labels": ["harness-managed"],
      "statusMap": {
        "backlog": "open",
        "planned": "open",
        "in-progress": "open",
        "done": "closed",
        "blocked": "open"
      },
      "reverseStatusMap": {
        "closed": "done",
        "open:in-progress": "in-progress",
        "open:blocked": "blocked",
        "open:planned": "planned"
      }
    }
  },
  "canary": {
    "guardian": {
      "coverageExempt": [
        {
          "glob": "scripts/**",
          "reason": "node --test without lcov; instrument and delete (#883, ADR 0024)"
        },
        {
          "glob": "agents/skills/**",
          "reason": "skill scripts emit no lcov; instrument and delete (#883, ADR 0024)"
        }
      ]
    }
  }
}
